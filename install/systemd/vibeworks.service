# VibeWorks – Web-App (Next.js)
# Wird vom Installer bzw. vom update-Befehl nach /etc/systemd/system/ kopiert.
[Unit]
Description=VibeWorks – Projekt-Kontrollzentrum
Documentation=https://github.com/MoinMornhart/vibeworks
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=vibeworks
Group=vibeworks
WorkingDirectory=/opt/vibeworks/current
EnvironmentFile=/opt/vibeworks/shared/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
SyslogIdentifier=vibeworks

# Vorsichtiges Hardening, das auch in unprivilegierten LXC-Containern funktioniert
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vibeworks/shared
UMask=0027

[Install]
WantedBy=multi-user.target
