// ─────────────────────────────────────────────────────────────
//  VibeWorks – Datenmodell (PostgreSQL)
// ─────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────

enum UserRole {
  ADMIN
  USER
}

/// SINGLE: genau ein Konto. MULTI: beliebig viele, strikt getrennte Konten.
enum InstanceMode {
  SINGLE
  MULTI
}

enum ProjectStatus {
  IDEA
  PLANNING
  OPEN
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum TaskStatus {
  TODO
  DOING
  BLOCKED
  DONE
}

enum Recurrence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum ActivityKind {
  PROJECT_CREATED
  PROJECT_UPDATED
  STATUS_CHANGED
  NOTE_ADDED
  NOTE_UPDATED
  NOTE_DELETED
  TASK_ADDED
  TASK_MOVED
  TASK_DELETED
}

/// Art einer Seite in den Mini-Docs
enum DocKind {
  PAGE
  WEB
  HTML
}

/// Wer eine Seite sehen darf
enum DocShare {
  PRIVATE
  ACCOUNTS
  PUBLIC
}

// ── Instanz ─────────────────────────────────────────────────

/// Genau eine Zeile (id = "instance").
model Settings {
  id                String       @id @default("instance")
  mode              InstanceMode @default(SINGLE)
  allowRegistration Boolean      @default(false)
  /// Höchstzahl Karten je Spalte im Aufgabenbrett (0 = unbegrenzt).
  taskColumnLimit   Int          @default(15)
  setupDoneAt       DateTime?
  updatedAt         DateTime     @updatedAt
}

// ── Konten und Anmeldung ────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  /// Immer kleingeschrieben.
  username     String   @unique
  displayName  String?
  email        String?  @unique
  /// scrypt$N$r$p$salt$hash – null bei reinen Passkey-Konten.
  passwordHash String?
  role         UserRole @default(USER)
  active       Boolean  @default(true)

  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  /// TOTP-Schlüssel (verschlüsselt). Scharf erst mit totpEnabledAt.
  totpSecret     String?
  totpEnabledAt  DateTime?
  totpLastStep   Int?

  /// Persönliches Design (Hintergrund, Farben, Modus, Glas) – siehe src/lib/theme.
  theme Json?

  sessions      Session[]
  passkeys      Passkey[]
  recoveryCodes RecoveryCode[]
  mfaPending    MfaPending[]
  projects      Project[]
  activities    Activity[]
  uploads       Upload[]
  docs          Doc[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Serverseitige Sitzung; gespeichert wird nur der SHA-256 des Cookie-Tokens.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Passwort war richtig, der zweite Faktor steht noch aus.
model MfaPending {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// base64url-Credential-ID
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  name         String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

/// Einmal verwendbare WebAuthn-Challenge.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  userId    String?
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ── Projekte ────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  summary     String?
  description String?
  status      ProjectStatus @default(IDEA)
  /// 1 niedrig · 2 normal · 3 hoch · 4 kritisch
  priority    Int           @default(2)
  progress    Int           @default(0)
  /// Name eines Akzentverlaufs (siehe src/lib/accents.ts)
  accent      String        @default("violet")
  tags        String[]      @default([])
  favorite    Boolean       @default(false)
  /// Rang innerhalb der Kanban-Spalte
  position    Int           @default(0)
  progressFromTasks Boolean @default(false)
  repoUrl     String?
  /// Zugangstoken für private Repositories, AES-256-GCM-verschlüsselt
  repoTokenCipher String?
  /// Gekürzte Anzeige des Tokens, z. B. "ghp_…9f3a"
  repoTokenHint   String?
  /// Aufgaben automatisch als Issues im Repository spiegeln (braucht ein Token)
  issueSync       Boolean @default(true)

  notes      Note[]
  tasks      Task[]
  activities Activity[]
  repoCache  RepoCache?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, slug])
  @@index([ownerId, status, position])
  @@index([ownerId, updatedAt])
}

model Note {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Task {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus  @default(TODO)
  position    Int         @default(0)
  dueDate     DateTime?
  labels      String[]    @default([])
  doneAt      DateTime?
  /// Letzter Statuswechsel – Erledigtes und Blockiertes blendet das Board nach 2 Tagen aus
  statusChangedAt DateTime @default(now())
  recurrence  Recurrence?
  /// Vorgängerin bei wiederkehrenden Aufgaben (bewusst ohne Fremdschlüssel)
  recurredFrom String?
  /// Gespiegeltes Issue im verknüpften Repository
  issueNumber Int?
  issueUrl    String?
  /// Letzter Fehler beim Spiegeln – wird beim nächsten Erfolg geleert
  issueError  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId, status, position])
  @@index([dueDate])
}

model Activity {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      ActivityKind
  summary   String
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([projectId, createdAt])
  @@index([createdAt, id])
}

/// Zwischengespeicherter Stand des verknüpften Repositories (Commits).
/// Ein fehlgeschlagener Abgleich setzt nur `error` – die zuletzt geholten
/// Commits bleiben stehen.
model RepoCache {
  projectId     String   @id
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// github | gitlab | gitea
  provider      String
  fullName      String
  webUrl        String
  defaultBranch String?
  description   String?
  stars         Int?
  /// [{ sha, title, body, author, date, url }], neueste zuerst
  commits       Json     @default("[]")
  fetchedAt     DateTime @default(now())
  error         String?
}

// ── Dateien ─────────────────────────────────────────────────

/// Hochgeladene Datei (z. B. eigenes Hintergrundbild). Die Datei selbst
/// liegt unter DATA_DIR/uploads/<id>.<ext>.
model Upload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("background")
  mime      String
  ext       String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Mini-Docs ───────────────────────────────────────────────

/// Eine Seite in den Mini-Docs: Markdown-Seite, gespeicherte Webseite oder
/// eigene HTML-Seite. Seiten bilden einen Baum; privat, optional teilbar.
model Doc {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Doc?      @relation("DocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Doc[]     @relation("DocTree")
  kind       DocKind   @default(PAGE)
  title      String
  /// Emoji vor dem Titel
  icon       String?
  /// Markdown (Seite, Notizen zu einer Webseite) bzw. HTML-Quelltext
  content    String    @default("")
  /// Gespeicherte Webseite: Adresse und archivierter, lesbarer Inhalt
  sourceUrl  String?
  archive    String?
  archivedAt DateTime?
  /// Rang unter den Geschwistern im Baum
  position   Int       @default(0)
  pinned     Boolean   @default(false)
  share      DocShare  @default(PRIVATE)
  shareToken String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId, parentId, position])
}
