// ─────────────────────────────────────────────────────────────
//  VibeWorks – Datenmodell (PostgreSQL)
// ─────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────

enum UserRole {
  ADMIN
  USER
}

/// SINGLE: genau ein Konto. MULTI: beliebig viele, strikt getrennte Konten.
enum InstanceMode {
  SINGLE
  MULTI
}

enum ProjectStatus {
  IDEA
  PLANNING
  OPEN
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum TaskStatus {
  TODO
  DOING
  BLOCKED
  DONE
}

enum Recurrence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum ActivityKind {
  PROJECT_CREATED
  PROJECT_UPDATED
  STATUS_CHANGED
  NOTE_ADDED
  NOTE_UPDATED
  NOTE_DELETED
  TASK_ADDED
  TASK_MOVED
  TASK_DELETED
}

/// Art einer Seite in den Mini-Docs
enum DocKind {
  PAGE
  WEB
  HTML
}

/// Wer eine Seite sehen darf
enum DocShare {
  PRIVATE
  ACCOUNTS
  PUBLIC
}

// ── Instanz ─────────────────────────────────────────────────

/// Genau eine Zeile (id = "instance").
model Settings {
  id                String       @id @default("instance")
  mode              InstanceMode @default(SINGLE)
  allowRegistration Boolean      @default(false)
  /// Höchstzahl Karten je Spalte im Aufgabenbrett (0 = unbegrenzt).
  taskColumnLimit   Int          @default(15)
  setupDoneAt       DateTime?
  /// SMTP für Benachrichtigungen per E-Mail (Passwort AES-256-GCM)
  smtpHost          String?
  smtpPort          Int?
  smtpSecure        Boolean      @default(false)
  smtpUser          String?
  smtpPassCipher    String?
  smtpFrom          String?
  /// Zuletzt gestartete Version – für die Meldung „VibeWorks aktualisiert“
  lastVersion       String?
  updatedAt         DateTime     @updatedAt
}

// ── Konten und Anmeldung ────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  /// Immer kleingeschrieben.
  username     String   @unique
  displayName  String?
  email        String?  @unique
  /// scrypt$N$r$p$salt$hash – null bei reinen Passkey-Konten.
  passwordHash String?
  role         UserRole @default(USER)
  active       Boolean  @default(true)

  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  /// TOTP-Schlüssel (verschlüsselt). Scharf erst mit totpEnabledAt.
  totpSecret     String?
  totpEnabledAt  DateTime?
  totpLastStep   Int?

  /// Persönliches Design (Hintergrund, Farben, Modus, Glas) – siehe src/lib/theme.
  theme Json?

  /// Sprache der Oberfläche ("de" | "en") – null heißt: Browsersprache
  locale String?

  sessions      Session[]
  passkeys      Passkey[]
  recoveryCodes RecoveryCode[]
  mfaPending    MfaPending[]
  projects      Project[]
  activities    Activity[]
  uploads       Upload[]
  docs          Doc[]
  memberships    ProjectMember[]
  accessRequests AccessRequest[]
  gitCredentials GitCredential[]
  apiTokens      ApiToken[]
  notifications  Notification[]
  taskFocus      TaskFocus[]
  prompts        Prompt[]
  timeEntries    TimeEntry[]
  templates      ProjectTemplate[]
  notificationSettings NotificationSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Serverseitige Sitzung; gespeichert wird nur der SHA-256 des Cookie-Tokens.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Passwort war richtig, der zweite Faktor steht noch aus.
model MfaPending {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// base64url-Credential-ID
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  name         String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

/// Einmal verwendbare WebAuthn-Challenge.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  userId    String?
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ── Projekte ────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  summary     String?
  description String?
  status      ProjectStatus @default(IDEA)
  /// 1 niedrig · 2 normal · 3 hoch · 4 kritisch
  priority    Int           @default(2)
  progress    Int           @default(0)
  /// Name eines Akzentverlaufs (siehe src/lib/accents.ts)
  accent      String        @default("violet")
  tags        String[]      @default([])
  favorite    Boolean       @default(false)
  /// Rang innerhalb der Kanban-Spalte
  position    Int           @default(0)
  progressFromTasks Boolean @default(false)
  repoUrl     String?
  /// Zugangstoken für private Repositories, AES-256-GCM-verschlüsselt
  repoTokenCipher String?
  /// Gekürzte Anzeige des Tokens, z. B. "ghp_…9f3a"
  repoTokenHint   String?
  /// Aufgaben automatisch als Issues im Repository spiegeln (braucht ein Token)
  issueSync       Boolean @default(true)
  /// Geheimer Teil des öffentlichen Links /s/<token> – null heißt „nicht geteilt“
  shareToken      String? @unique
  /// Geheimnis für eingehende Webhooks (AES-256-GCM) – null heißt „kein Webhook“
  webhookSecretCipher String?
  /// Zuletzt ein gültiger Webhook angekommen
  webhookAt           DateTime?
  /// Live-Überwachung: die fertige Seite, alle 5 Minuten geprüft
  liveUrl        String?
  /// "up" | "down" – null, solange noch nicht geprüft
  liveState      String?
  /// Fehlschläge in Folge – offline gilt eine Seite erst ab zwei
  liveFails      Int       @default(0)
  liveMs         Int?
  liveError      String?
  /// Seit wann der aktuelle Zustand gilt
  liveSince      DateTime?
  liveCheckedAt  DateTime?
  sslExpiresAt   DateTime?
  sslCheckedAt   DateTime?
  /// Schon gemeldete Warnstufe ("14" | "3") – nach Verlängerung wieder null
  sslNotified    String?
  /// Vorschaubild der Seite (og:image, sonst Icon) als Upload
  coverUploadId  String?
  coverCheckedAt DateTime?
  /// Projekt-Friedhof: begraben (Status dann ARCHIVED), Ursache, letzte Worte
  buriedAt           DateTime?
  epitaph            String?
  causeOfDeath       String?
  statusBeforeBurial ProjectStatus?
  /// „Später fragen“ – bis dahin kein Hinweis auf dem Dashboard
  nudgeSnoozedUntil  DateTime?

  notes      Note[]
  tasks      Task[]
  activities Activity[]
  repoCache  RepoCache?
  members        ProjectMember[]
  accessRequests AccessRequest[]
  uptimeChecks   UptimeCheck[]
  prompts        Prompt[]
  costs          ProjectCost[]
  timeEntries    TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, slug])
  @@index([ownerId, status, position])
  @@index([ownerId, updatedAt])
}

model Note {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Task {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus  @default(TODO)
  position    Int         @default(0)
  dueDate     DateTime?
  labels      String[]    @default([])
  doneAt      DateTime?
  /// Letzter Statuswechsel – Erledigtes und Blockiertes blendet das Board nach 2 Tagen aus
  statusChangedAt DateTime @default(now())
  recurrence  Recurrence?
  /// Vorgängerin bei wiederkehrenden Aufgaben (bewusst ohne Fremdschlüssel)
  recurredFrom String?
  /// Gespiegeltes Issue im verknüpften Repository
  issueNumber Int?
  issueUrl    String?
  /// Letzter Fehler beim Spiegeln – wird beim nächsten Erfolg geleert
  issueError  String?
  focus       TaskFocus[]
  timeEntries TimeEntry[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId, status, position])
  @@index([dueDate])
}

model Activity {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      ActivityKind
  summary   String
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([projectId, createdAt])
  @@index([createdAt, id])
}

/// Zwischengespeicherter Stand des verknüpften Repositories (Commits).
/// Ein fehlgeschlagener Abgleich setzt nur `error` – die zuletzt geholten
/// Commits bleiben stehen.
model RepoCache {
  projectId     String   @id
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// github | gitlab | gitea
  provider      String
  fullName      String
  webUrl        String
  defaultBranch String?
  description   String?
  stars         Int?
  /// [{ sha, title, body, author, date, url }], neueste zuerst
  commits       Json     @default("[]")
  /// CI des Hauptzweigs: { state, runs: [{ name, state, url, updatedAt }], sha, checkedAt } – null ohne CI
  ci            Json?
  fetchedAt     DateTime @default(now())
  error         String?
}

/// Git-Verbindung eines Kontos (GitHub, GitLab, Gitea/Forgejo, auch selbst
/// gehostet). Gilt für alle eigenen Projekte auf diesem Server, sofern ein
/// Projekt kein eigenes Token hat. Je Konto und Server höchstens eine.
model GitCredential {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// github | gitlab | gitea
  provider  String
  /// host[:port], kleingeschrieben – Abgleich mit der Repository-Adresse
  host      String
  /// https://host[:port] – Basis für API-Aufrufe
  baseUrl   String
  /// Token, AES-256-GCM-verschlüsselt
  cipher    String
  /// Gekürzte Anzeige, z. B. "ghp_…9f3a"
  hint      String
  /// Anmeldename beim Anbieter, beim Speichern ermittelt
  login     String?
  createdAt DateTime @default(now())

  @@unique([userId, host])
}

/// Eigene Projektvorlage: Momentaufnahme von Angaben, Aufgaben und Notizen.
/// Die eingebauten Vorlagen stehen im Code (src/lib/templateData.ts).
model ProjectTemplate {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// { summary, description, accent, tags, priority, progressFromTasks, tasks: [...], notes: [...] }
  data        Json
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

/// API-Schlüssel für Claude Code und andere MCP-Clients – gespeichert wird nur der SHA-256.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  /// Gekürzte Anzeige, z. B. "vw_AbCd…9f3a"
  hint       String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Erfasste Zeit an einer Aufgabe – endedAt null heißt: läuft gerade (höchstens eine je Konto).
model TimeEntry {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  seconds      Int       @default(0)
  /// Fokus-Timer: Ziel in Minuten (z. B. 25) – null bei der Stoppuhr
  focusMinutes Int?
  createdAt    DateTime  @default(now())

  @@index([userId, endedAt])
  @@index([projectId])
  @@index([taskId])
}

/// Laufende oder einmalige Kosten eines Projekts (Hosting, Domain, KI-API …).
model ProjectCost {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  amountCents Int
  currency    String   @default("EUR")
  /// MONTHLY | YEARLY | ONCE
  interval    String   @default("MONTHLY")
  /// Nächste Verlängerung "YYYY-MM-DD" – rückt nach dem Termin von selbst weiter
  renewsOn    String?
  note        String?
  /// Für welche Verlängerung schon gewarnt wurde
  notifiedFor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

/// Prompt-Bibliothek eines Kontos – allgemein oder an ein Projekt gebunden.
model Prompt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String
  /// Text mit Platzhaltern wie {{projekt}}, {{repo}}, {{live}}, {{summary}}
  body      String
  tags      String[] @default([])
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Heute-Ansicht: bis zu fünf Aufgaben, die sich ein Konto für einen Tag vornimmt.
model TaskFocus {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Kalendertag "YYYY-MM-DD" (Europe/Berlin)
  day       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, taskId, day])
  @@index([userId, day])
}

/// Einzelne Prüfung einer Live-Seite – 30 Tage aufbewahrt.
model UptimeCheck {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  ok        Boolean
  status    Int?
  ms        Int?
  error     String?

  @@index([projectId, at])
}

/// Posteingang der Benachrichtigungen – die Windows-App holt ihn ab; nach 30 Tagen gelöscht.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  title     String
  message   String
  url       String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Benachrichtigungen eines Kontos: Kanäle und Anlässe
model NotificationSettings {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Vollständige ntfy-Adresse samt Thema, z. B. https://ntfy.sh/mein-thema
  ntfyUrl         String?
  /// Optionales ntfy-Zugangstoken (AES-256-GCM)
  ntfyTokenCipher String?
  /// Webhook – Discord, Slack oder beliebiger JSON-Empfänger
  webhookUrl      String?
  /// Versand über den SMTP-Server der Instanz
  email           String?
  /// { taskDue, accessRequest, issueClosed, ciFailed, updated } – fehlt ein Schlüssel, ist der Anlass an
  events          Json      @default("{}")
  /// Kalendertag der letzten Zusammenfassung fälliger Aufgaben
  digestSentOn    String?
  lastSentAt      DateTime?
  /// "kanal|meldung" des letzten Fehlschlags
  lastError       String?
  updatedAt       DateTime  @updatedAt
}

// ── Teilen ──────────────────────────────────────────────────

enum ProjectRole {
  VIEWER
  EDITOR
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

/// Mitglied eines geteilten Projekts. Der Besitzer steht nicht hier, sondern in Project.ownerId.
model ProjectMember {
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

/// Anfrage auf Zugriff über einen geteilten Link – je Konto und Projekt höchstens eine.
model AccessRequest {
  id        String              @id @default(cuid())
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole         @default(VIEWER)
  message   String?
  status    AccessRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())
  decidedAt DateTime?

  @@unique([projectId, userId])
  @@index([projectId, status])
}

// ── Dateien ─────────────────────────────────────────────────

/// Hochgeladene Datei (z. B. eigenes Hintergrundbild). Die Datei selbst
/// liegt unter DATA_DIR/uploads/<id>.<ext>.
model Upload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("background")
  mime      String
  ext       String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Mini-Docs ───────────────────────────────────────────────

/// Eine Seite in den Mini-Docs: Markdown-Seite, gespeicherte Webseite oder
/// eigene HTML-Seite. Seiten bilden einen Baum; privat, optional teilbar.
model Doc {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Doc?      @relation("DocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Doc[]     @relation("DocTree")
  kind       DocKind   @default(PAGE)
  title      String
  /// Emoji vor dem Titel
  icon       String?
  /// Markdown (Seite, Notizen zu einer Webseite) bzw. HTML-Quelltext
  content    String    @default("")
  /// Gespeicherte Webseite: Adresse und archivierter, lesbarer Inhalt
  sourceUrl  String?
  archive    String?
  archivedAt DateTime?
  /// Rang unter den Geschwistern im Baum
  position   Int       @default(0)
  pinned     Boolean   @default(false)
  share      DocShare  @default(PRIVATE)
  shareToken String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId, parentId, position])
}
