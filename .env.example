# ─────────────────────────────────────────────────────────────
#  VibeWorks – Konfiguration
#  Kopieren nach .env (oder `npm run setup` ausführen, das erzeugt
#  gleich ein zufälliges APP_SECRET).
# ─────────────────────────────────────────────────────────────

# Anzeigename in Kopfzeile, Seitentitel und Passkey-Dialog
APP_NAME=VibeWorks

# Öffentliche Adresse, unter der die App aufgerufen wird.
# Bestimmt die Passkey-Domain (RP-ID): Passkeys funktionieren nur über
# https:// oder http://localhost.
APP_URL=http://localhost:3000

# PostgreSQL-Verbindung
DATABASE_URL=postgresql://vibeworks:vibeworks@localhost:5433/vibeworks?schema=public

# Schlüssel für die Verschlüsselung gespeicherter Geheimnisse (AES-256-GCM).
# Mindestens 32 Zeichen, zufällig. Nachträglich ändern macht gespeicherte
# Git-Tokens und Zwei-Faktor-Schlüssel unlesbar.
APP_SECRET=

# Port der Anwendung
PORT=3000

# Ordner für Laufzeitdaten (hochgeladene Hintergrundbilder, Backups)
DATA_DIR=./data

# Sitzungen: absolute Lebensdauer in Tagen und Leerlauf in Stunden (0 = aus)
SESSION_TTL_DAYS=30
SESSION_IDLE_HOURS=8
